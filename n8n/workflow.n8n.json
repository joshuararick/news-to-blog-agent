{
  "name": "News → AI (OpenRouter) → PayloadCMS blog drafts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 7
            }
          ]
        }
      },
      "name": "Every Morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "every-morning"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "industry",
              "value": "HVAC",
              "type": "string"
            },
            {
              "id": "2",
              "name": "location",
              "value": "Greenville SC",
              "type": "string"
            },
            {
              "id": "3",
              "name": "payloadUrl",
              "value": "https://YOUR-SITE.com",
              "type": "string"
            },
            {
              "id": "4",
              "name": "collection",
              "value": "posts",
              "type": "string"
            },
            {
              "id": "5",
              "name": "aiModel",
              "value": "PICK-FROM-openrouter.ai/models",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "id": "config"
    },
    {
      "parameters": {
        "url": "={{ 'https://news.google.com/rss/search?q=' + encodeURIComponent($json.industry + ' ' + $json.location + ' when:7d') + '&hl=en-US&gl=US&ceid=US:en' }}",
        "options": {}
      },
      "name": "Google News",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "id": "google-news",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "operation": "removeItemRepeatedAcrossExecutions",
        "dedupeValue": "={{ $json.link }}",
        "options": {}
      },
      "name": "Skip Already Posted",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "skip-already-posted"
    },
    {
      "parameters": {
        "maxItems": 3
      },
      "name": "Keep 3 Newest",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        880,
        0
      ],
      "id": "keep-3-newest"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Title",
              "value": "News-to-Blog Agent"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.aiModel, max_tokens: 1024, messages: [{ role: 'system', content: 'You write short, friendly local-news blog posts for a ' + $('Config').first().json.industry + ' business in ' + $('Config').first().json.location + '. Rules: Use only the facts in the story details you are given. Never invent quotes, numbers, names or events. 200 to 400 words, plain paragraphs, no markdown headings. Reply with JSON only, shaped exactly like: {\"title\": \"...\", \"body\": \"...\"}' }, { role: 'user', content: 'Headline: ' + $json.title + '\\nLink: ' + $json.link + '\\nPublished: ' + ($json.pubDate || 'unknown') } ] }) }}",
        "options": {}
      },
      "name": "AI Writes Post (OpenRouter)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "id": "ai-writes-post",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "OpenRouter (header Authorization: Bearer <key>)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Turn each AI reply into a Payload draft, rejecting replies that are unusable.\n// Same checks as the Node.js version (src/writers/blogPostPrompt.js).\nconst MINIMUM_WORDS = 120;\nconst MAXIMUM_WORDS = 500;\nconst stories = $('Keep 3 Newest').all();\n\nreturn $input.all().map((item, index) => {\n  if (item.json.error) throw new Error(`OpenRouter error: ${item.json.error.message}`);\n  const replyText = item.json.choices?.[0]?.message?.content ?? '';\n  const post = JSON.parse(replyText.slice(replyText.indexOf('{'), replyText.lastIndexOf('}') + 1));\n\n  const wordCount = String(post.body ?? '').split(/\\s+/).filter(Boolean).length;\n  if (!post.title || wordCount < MINIMUM_WORDS || wordCount > MAXIMUM_WORDS) {\n    throw new Error(`Unusable AI reply (title: ${Boolean(post.title)}, words: ${wordCount})`);\n  }\n\n  return { json: { title: post.title, summary: post.body, sourceUrl: stories[index].json.link, _status: 'draft' } };\n});"
      },
      "name": "Shape Post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "id": "shape-post"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.payloadUrl + '/api/' + $('Config').first().json.collection }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "name": "Save Draft to Payload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "id": "save-draft-to-payload",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Payload (header Authorization: users API-Key ...)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Every Morning": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Google News",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google News": {
      "main": [
        [
          {
            "node": "Skip Already Posted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Skip Already Posted": {
      "main": [
        [
          {
            "node": "Keep 3 Newest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep 3 Newest": {
      "main": [
        [
          {
            "node": "AI Writes Post (OpenRouter)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Writes Post (OpenRouter)": {
      "main": [
        [
          {
            "node": "Shape Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape Post": {
      "main": [
        [
          {
            "node": "Save Draft to Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}