# Copy to .env and fill in. Never commit the real .env.

# Required
ANTHROPIC_API_KEY=sk-ant-...
NEWS_INDUSTRY=HVAC
NEWS_LOCATION=Greenville SC

# Required unless running with --dry-run
PAYLOAD_URL=https://your-site.com
PAYLOAD_API_KEY=...

# Optional
# PAYLOAD_COLLECTION=posts
# CLAUDE_MODEL=claude-haiku-5-5        # claude-sonnet-5-5 for richer writing
# MAX_POSTS_PER_RUN=3
# NEWS_LOOKBACK_DAYS=7
# SEEN_STORIES_FILE=.seen-stories.json
