# Copy to .env and fill in. Never commit the real .env.

# Required
NEWS_INDUSTRY=HVAC
NEWS_LOCATION=Greenville SC

# Which AI writes the posts: "anthropic" (Claude directly) or "openrouter" (any model)
AI_PROVIDER=anthropic

# If AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-5-5        # claude-sonnet-5-5 for richer writing

# If AI_PROVIDER=openrouter (pick a model slug at https://openrouter.ai/models)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=<provider>/<model>

# Required unless running with --dry-run
PAYLOAD_URL=https://your-site.com
PAYLOAD_API_KEY=...

# Optional
# PAYLOAD_COLLECTION=posts
# MAX_POSTS_PER_RUN=3
# NEWS_LOOKBACK_DAYS=7
# SEEN_STORIES_FILE=.seen-stories.json
